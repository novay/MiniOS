{
    "name": "novay/minios",
    "description": "MiniOS Desktop Environment for Laravel",
    "keywords": [
        "laravel",
        "desktop",
        "livewire",
        "web-os",
        "desktop-environment",
        "window-manager",
        "alpinejs",
        "minios"
    ],
    "homepage": "https://github.com/novay/minios",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Noviyanto Rahmadi",
            "email": "novay@btekno.id",
            "homepage": "https://github.com/novay",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required to use AWS S3 storage driver in MiniOS Settings (^3.0).",
        "platformcommunity/flysystem-bunnycdn": "Required to use BunnyCDN storage driver in MiniOS Settings (^3.4).",
        "resend/resend-laravel": "Required to use Resend mail driver in MiniOS Settings (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Novay\\MiniOS\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Novay\\MiniOS\\MiniOSServiceProvider"
            ],
            "aliases": {
                "MiniOS": "Novay\\MiniOS\\Facades\\MiniOS"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
